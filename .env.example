# ── Healy Backend — variables d'environnement ──────────────────────────────
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne jamais committer .env dans git.

# Django
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
# En dev : localhost,127.0.0.1
# En prod : domaines réels séparés par virgules. JAMAIS '*' (refus de démarrer).
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Base de données PostgreSQL
DB_NAME=medical_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP — utiliser un App Password généré depuis les paramètres Google)
# Compte Google → Sécurité → Authentification 2 facteurs → Mots de passe d'application
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# CORS
# En dev : CORS_ALLOW_ALL=True
# En prod : CORS_ALLOW_ALL=False et renseigner CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://Healy.example.com

# IA Diagnostic (Google Gemini)
# Créer une clé sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
