# ── MedSmart Backend — TEMPLATE PRODUCTION ────────────────────────────────────
# À copier en `.env` sur le serveur de prod et remplir.
# Ne JAMAIS committer ce fichier rempli.
#
# Vérifications critiques avant déploiement :
#   1. DEBUG=False
#   2. SECRET_KEY = nouvelle clé jamais utilisée en dev
#   3. ALLOWED_HOSTS = domaines réels, sans '*'
#   4. CORS_ALLOW_ALL=False + CORS_ALLOWED_ORIGINS = https uniquement
#   5. EMAIL_HOST_PASSWORD et GEMINI_API_KEY rotés (différents de dev)
#   6. DB_PASSWORD fort (>= 24 chars, généré aléatoirement)

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=GENERER-NOUVELLE-CLE-PROD-NE-PAS-REUTILISER-DEV
DEBUG=False
ALLOWED_HOSTS=medsmart.dz,api.medsmart.dz
FRONTEND_URL=https://medsmart.dz

# ── Base de données ─────────────────────────────────────────────────────────
DB_NAME=medical_db
DB_USER=medsmart_prod
DB_PASSWORD=MOT-DE-PASSE-FORT-24-CHARS-MIN
DB_HOST=localhost
DB_PORT=5432

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_HOST_USER=noreply@medsmart.dz
EMAIL_HOST_PASSWORD=app-password-prod-distinct-de-dev

# ── CORS (HTTPS uniquement en prod) ─────────────────────────────────────────
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://medsmart.dz,https://www.medsmart.dz

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=cle-gemini-prod-distincte-de-dev
GEMINI_MODEL=gemini-2.5-flash
